rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /tickets/{ticketId} {
      allow read, write: if isValidId(ticketId);

      match /messages/{messageId} {
        allow read, write: if isValidId(ticketId) && isValidId(messageId);
      }
    }

    match /technicians/{technicianId} {
      allow read, write: if isValidId(technicianId);
    }

    match /priceCategories/{categoryId} {
      allow read, write: if isValidId(categoryId);
    }

    match /invoices/{invoiceId} {
      allow read, write: if isValidId(invoiceId);
    }

    match /workbenchNotifications/{notificationId} {
      allow read, write: if isValidId(notificationId);
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
